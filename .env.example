# Copy this file to .env and fill in your own values. .env is gitignored.

# Gmail address used to send alert emails
EMAIL_ADDRESS=you@gmail.com

# Gmail App Password (not your regular password) — see README for how to generate one
EMAIL_PASSWORD=

# Where alerts get sent. Single address or comma-separated list.
TO_EMAIL=you@gmail.com

# Optional — only needed if you're not using Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Optional — a GitHub token to raise the API rate limit for local testing.
# Not needed in GitHub Actions (the workflow provides GITHUB_TOKEN automatically).
# GH_TOKEN=
